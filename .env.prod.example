# Copy this file to .env.prod, fill in the real values, then deploy:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Start the optional Cloudflare Tunnel (free HTTPS) with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml --profile tunnel up -d

# --- Application ---
# Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=https://api.yourdomain.com

# --- Frontend (SPA) ---
FRONTEND_URL=https://app.yourdomain.com
# Exact frontend origin, no trailing slash
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
# SameSite policy: lax (same-site subdomains) or none (different sites)
SESSION_SAME_SITE=lax
AUTH_COOKIE_SAME_SITE=lax

# --- Database ---
DB_DATABASE=rawijli
DB_USERNAME=rawijli
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-password

# --- Redis (leave empty to run without a password on the private network) ---
REDIS_PASSWORD=

# --- Mail (optional; leave log to disable) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@yourdomain.com
MAIL_FROM_NAME=Rawijli

# --- Integrations (optional; empty = sandbox mode) ---
DEEPSEEK_API_KEY=
AI_PROVIDER=auto
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# --- Cloudflare Tunnel (for free HTTPS without opening ports) ---
# Create a tunnel at https://one.dash.cloudflare.com -> Networks -> Tunnels
# Point its public hostname (api.yourdomain.com) at: http://app:80
CLOUDFLARE_TUNNEL_TOKEN=
