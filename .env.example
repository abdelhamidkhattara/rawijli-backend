APP_NAME=Rawijli
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=rawijli
DB_USERNAME=rawijli
DB_PASSWORD=rawijli_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@rawijli.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# Rawijli integrations
# ---------------------------------------------------------------
# auto = use live drivers when credentials exist, otherwise sandbox
INTEGRATIONS_DRIVER=auto
# auto | deepseek | sandbox
AI_PROVIDER=auto

FRONTEND_URL=http://localhost:5173
MEDIA_DISK=public
MARKETPLACE_FEE_PERCENT=10

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=45

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/api/connections/oauth/meta/callback"
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSION=v21.0
META_SCOPES=ads_read,ads_management,business_management,pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_CLIENT_KEY="${TIKTOK_APP_ID}"
TIKTOK_CLIENT_SECRET="${TIKTOK_APP_SECRET}"
TIKTOK_REDIRECT_URI="${APP_URL}/api/connections/oauth/tiktok/callback"
TIKTOK_CONTENT_BASE=https://open.tiktokapis.com
TIKTOK_MARKETING_BASE=https://business-api.tiktok.com
TIKTOK_SCOPES=user.info.basic,video.publish

VITE_APP_NAME="${APP_NAME}"
